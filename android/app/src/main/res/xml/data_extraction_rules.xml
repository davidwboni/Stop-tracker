<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Prevent cloud backup and device transfer of local delivery/financial data. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

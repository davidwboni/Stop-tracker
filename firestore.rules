rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAnonymousAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);

      // A client may create its own profile, but can only start on the expected
      // free/guest entitlement. Admin SDK / billing functions bypass rules and
      // are the only code allowed to grant Pro later.
      allow create: if signedInAs(userId)
        && request.resource.data.role ==
          (isAnonymousAuth() ? 'guest' : 'free')
        && !request.resource.data.keys().hasAny([
          'stripeCustomerId',
          'stripeSubscriptionId',
          'billingStatus',
          'billingUpdatedAt'
        ]);

      // Profile edits are allowed, but entitlement and billing fields are
      // server-owned. Billing webhooks/Admin SDK are the only writers.
      allow update: if signedInAs(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'isGuest',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'billingStatus',
          'billingUpdatedAt'
        ]);

      allow delete: if signedInAs(userId);

      // Covers every subcollection under a user's own document (deliveryLogs,
      // settings, and future user-owned data).
      match /{document=**} {
        allow read, write: if signedInAs(userId);
      }
    }

    match /payPeriodData/{userId} {
      allow read, write: if signedInAs(userId);
    }

    match /invoiceData/{userId} {
      allow read, write: if signedInAs(userId);
    }

    match /addressMemoryData/{userId} {
      allow read, write: if signedInAs(userId);
    }
  }
}

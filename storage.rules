rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/receipts/{expenseId}/{fileId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }
    // Preserve existing profile files and other owner-scoped folders, without
    // allowing a broad wildcard to bypass receipt size/type restrictions.
    match /users/{uid}/{file} { allow read, write: if owner(uid); }
    match /users/{uid}/{folder}/{rest=**} {
      allow read, write: if owner(uid) && folder != 'receipts';
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

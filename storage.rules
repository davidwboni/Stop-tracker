rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User-owned files only. Profile images and future statement uploads must
    // stay beneath users/{uid}/ so another authenticated user cannot read them.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
